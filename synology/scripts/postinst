#!/bin/sh
VAR="${SYNOPKG_PKGVAR:-/var/packages/tv-adb/var}"
mkdir -p "$VAR/data"
# wizard_password comes from the install wizard; an upgrade keeps the old one
if [ "$SYNOPKG_PKG_STATUS" != "UPGRADE" ] || [ ! -f "$VAR/password" ]; then
    printf '%s' "$wizard_password" > "$VAR/password"
    chmod 600 "$VAR/password"
fi
exit 0
