#!/bin/sh
PKG="tv-adb"
TARGET="${SYNOPKG_PKGDEST:-/var/packages/$PKG/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG/var}"
PID_FILE="$VAR/tv-adb.pid"
LOG_FILE="$VAR/tv-adb.log"

# own adb server port so we never fight another adb on the NAS
export HOME="$VAR"
export ANDROID_ADB_SERVER_PORT=15037

is_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

start_daemon() {
    is_running && return 0
    mkdir -p "$VAR/data"
    if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE")" -gt 5242880 ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.1"
    fi
    PASSWORD="$(cat "$VAR/password" 2>/dev/null)"
    export PASSWORD
    export PORT=8765
    export DATA_DIR="$VAR/data"
    export ADB="$TARGET/bin/adb"
    export PYTHONUNBUFFERED=1
    export PYTHONPYCACHEPREFIX="$VAR/pycache"
    nohup "$TARGET/python/bin/python3" "$TARGET/app/app.py" >> "$LOG_FILE" 2>&1 < /dev/null &
    echo $! > "$PID_FILE"
    sleep 2
    is_running
}

stop_daemon() {
    if is_running; then
        pid="$(cat "$PID_FILE")"
        kill "$pid" 2>/dev/null
        i=0
        while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do
            sleep 1
            i=$((i + 1))
        done
        kill -9 "$pid" 2>/dev/null
    fi
    rm -f "$PID_FILE"
    "$TARGET/bin/adb" kill-server > /dev/null 2>&1
    return 0
}

case "$1" in
    start) start_daemon ;;
    stop) stop_daemon ;;
    status) is_running && exit 0 || exit 3 ;;
    log) echo "$LOG_FILE" ;;
    *) exit 1 ;;
esac
